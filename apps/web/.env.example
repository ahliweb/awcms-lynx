# Copy to .env (git-ignored) or set in the build environment. Every PUBLIC_* value
# is inlined into the page at build time and is visible to every visitor:
# never put a secret here.

# Which AWCMS backend this build talks to: "awcms" (staff app) or "awcms-one" (customer app, default).
PUBLIC_AWCMS_BACKEND=awcms-one

# Where the app sends API requests. Leave EMPTY to use the page's own origin, which is what you want:
# awcms sends no CORS headers on its staff routes, so a browser can only reach it through a same-origin
# reverse proxy (deploy/Caddyfile.example, deploy/nginx.conf.example; `bun run dev` proxies for you).
PUBLIC_AWCMS_API_BASE_URL=

# awcms-one only: origin that serves /feed.json (the static catalog index). Empty = the page's own origin.
PUBLIC_AWCMS_STOREFRONT_ORIGIN=

# awcms only: tenant UUID sent as X-AWCMS-Tenant-ID. Empty = login asks for a membership.
PUBLIC_AWCMS_TENANT_ID=

# "id" (default) or "en"; also sets <html lang>.
PUBLIC_AWCMS_LOCALE=id

PUBLIC_AWCMS_APP_NAME=AWCMS Lynx

# Browser storage the host-bridge uses for the session: "local" (survives closing the tab) or
# "session" (dropped with the tab). Default: "session" for awcms (staff), "local" for awcms-one.
PUBLIC_AWCMS_WEB_SESSION_PERSISTENCE=

# <meta name="theme-color"> and the page background before the app paints.
PUBLIC_AWCMS_THEME_COLOR=#0f172a

# --- Dev/build tooling (not inlined into the page) ---------------------------------------------------
# Backend that `bun run dev` / `preview` proxy /api and /feed.json to.
AWCMS_DEV_PROXY_TARGET=http://localhost:4321
# Proxy the bundle from a running `rspeedy dev` (apps/mobile) instead of reading apps/mobile/dist.
# AWCMS_DEV_BUNDLE_ORIGIN=http://localhost:3000
# Directory holding main.web.bundle (default ../mobile/dist).
# AWCMS_WEB_BUNDLE_DIR=../mobile/dist
