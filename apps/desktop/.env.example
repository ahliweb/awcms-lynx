# Copy to .env (git-ignored) or set in the build environment. PUBLIC_* values are inlined
# into BOTH the Lynx UI bundle and the main process at build time and can be read by anyone
# who unpacks the app: never put a secret here. Same variables as apps/mobile and apps/web.

# "awcms" (staff app) or "awcms-one" (customer app, default).
PUBLIC_AWCMS_BACKEND=awcms-one

# Origin of the AWCMS backend. A desktop app is not a browser, so CORS does not apply:
# point it straight at the backend (https; http only for localhost / private LAN).
PUBLIC_AWCMS_API_BASE_URL=https://cms.example.id

# awcms-one only: origin that serves /feed.json (static catalog index).
PUBLIC_AWCMS_STOREFRONT_ORIGIN=

# awcms only: tenant UUID sent as X-AWCMS-Tenant-ID. Empty = login asks for a membership.
PUBLIC_AWCMS_TENANT_ID=

# "id" (default) or "en".
PUBLIC_AWCMS_LOCALE=id

# Window title. Keep productName in electron-builder.yml in step with it.
PUBLIC_AWCMS_APP_NAME=AWCMS Lynx
