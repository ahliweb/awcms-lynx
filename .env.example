# awcms-lynx build-time configuration.
#
# Copy to apps/mobile/.env (bundle defaults), apps/web/.env (web host
# globalProps) and apps/desktop/.env (desktop defaults). Every PUBLIC_
# variable is inlined into a bundle anyone can download: NEVER put a token,
# password, machine credential or provider key here (docs/security.md).
# Hosts may override each value at runtime through Lynx globalProps.

# awcms | awcms-one  — which backend profile this build targets (ADR-0001 D3).
PUBLIC_AWCMS_BACKEND=awcms-one

# Origin of the AWCMS backend, no trailing slash. https is required except for
# localhost / private LAN (offline-LAN profile). Android emulator: 10.0.2.2.
# Web builds against the awcms staff API: use the web app's own origin and
# reverse-proxy /api (apps/web/README.md) — those routes have no CORS.
PUBLIC_AWCMS_API_BASE_URL=http://localhost:4321

# awcms-one only: origin of the deployed Astro storefront serving
# /index/produk.json and /index/berita.json. Empty = catalog tab explains it.
PUBLIC_AWCMS_STOREFRONT_ORIGIN=

# awcms only: tenant UUID sent as X-AWCMS-Tenant-ID. Empty = sign-in asks for
# the workspace when the account belongs to more than one.
PUBLIC_AWCMS_TENANT_ID=

# id | en — default UI language (the user can switch in Settings).
PUBLIC_AWCMS_LOCALE=id

# Display name shown in the header and window title.
PUBLIC_AWCMS_APP_NAME=AWCMS Lynx

# Web host only: local | session — where the browser keeps the session.
# Default: session for awcms (staff), local for awcms-one (customer). ADR-0004 D5.
PUBLIC_AWCMS_WEB_SESSION_PERSISTENCE=

# Web host dev server only: backend the /api and /feed.json proxy forwards to.
AWCMS_DEV_PROXY_TARGET=http://localhost:4321
