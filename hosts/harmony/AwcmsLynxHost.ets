/*
 * Reference implementation — adapt package/bundle ids; derived from
 * lynx-family/integrating-lynx-demo-projects (Apache-2.0):
 *   harmony/HarmonyEmptyProject  EntryAbility.ets, pages/Index.ets,
 *   provider/ExampleTemplateResourceFetcher.ets, provider/ExampleMediaResourceFetcher.ets
 *
 * Lynx references followed (docs live in lynx-family/lynx-website):
 *   - guide/start/fragments/harmony/integrating-lynx-with-existing-app-harmony.mdx
 *       service registration, LynxEnv.initialize / setAppInfo, LynxTemplateResourceFetcher,
 *       LynxMediaResourceFetcher, LynxGenericResourceFetcher, <LynxView/> component
 *   - guide/custom-native-modules/native-module-harmony.mdx   modules map: { moduleClass, param? }
 *   - guide/start/integrate-lynx-devtool-advanced.mdx          LynxView({ modules, sendableModules, onCreate, ... })
 *   - guide/use-data-from-host-platform.mdx + api/lynx-native-api/lynx-update-meta.mdx
 *       MetaData(templateData, globalProps), TemplateData
 *   - api/lynx-native-api/lynx-context/send-global-event.mdx   LynxContext.sendGlobalEvent
 *
 * Files you still copy from the official sample, unchanged:
 *   provider/ExampleGenericResourceFetcher.ets  (needs @ohos/imageknife) — imported below as
 *   `ExampleGenericResourceFetcher`; adjust the import path to where you put it.
 *
 * Bundle loading policy
 *   Release: ONLY the packaged rawfile (entry/src/main/resources/rawfile/main.lynx.bundle; covered by the
 *            app signature). Remote fetching is switched off at runtime by BuildProfile.DEBUG.
 *   Debug  : rawfile, or an http(s) dev-server URL (rspeedy dev).
 */
import {
  LLog,
  LynxContext,
  LynxEnv,
  LynxError,
  LynxGenericResourceFetcher,
  LynxMediaResourceFetcher,
  LynxOptionalBool,
  LynxResourceRequest,
  LynxServiceCenter,
  LynxServiceType,
  LynxTemplateResourceFetcher,
  LynxView,
  MetaData,
  TemplateData,
  TemplateProviderResult,
} from '@lynx/lynx';
// VERIFY: exact exported name/type of the values of LynxView's `modules` map. The docs only show
// the literal `{ moduleClass: X, param?: Object }`; replace `ModuleOptions` with the SDK's type.
import { ModuleOptions } from '@lynx/lynx';
// The official sample (main) registers the log service on LynxBaseServiceCenter; the 4.0 guide text shows
// LynxServiceCenter + LynxServiceType.Log instead. VERIFY which one the pinned @lynx/lynx exports.
import { LynxBaseServiceCenter, LynxBaseServiceType } from '@lynx/lynx_base';
import { LynxHttpService } from '@lynx/lynx_http_service';
import { LynxLogService } from '@lynx/lynx_log_service';
import { AsyncCallback, BusinessError } from '@ohos.base';
import http from '@ohos.net.http';
import resourceManager from '@ohos.resourceManager';
import { common, Want } from '@kit.AbilityKit';
import BuildProfile from 'BuildProfile'; // generated by hvigor; BuildProfile.DEBUG is true for debug builds
import { AwcmsHostBridgeModule, AwcmsModuleParam } from './AwcmsHostBridgeModule';
import { ExampleGenericResourceFetcher } from '../provider/ExampleGenericResourceFetcher';

export const MODULE_NAME: string = 'AwcmsHostBridge'; // = HOST_BRIDGE_MODULE in packages/platform/src/contract.ts
export const DEFAULT_BUNDLE: string = 'main.lynx.bundle';
/** Global event used to deliver deep links to the bundle (proposed; see hosts/README.md). */
export const DEEP_LINK_EVENT: string = 'awcms:deeplink';

/**
 * Runtime overrides handed to the bundle as `lynx.__globalProps`
 * (packages/platform/src/runtime-config.ts resolves them over build-time defaults).
 * Nothing secret belongs here: globalProps are readable by every script in the bundle.
 * Empty fields are omitted so the bundle's build-time defaults apply.
 */
export class AwcmsRuntimeConfig {
  backend: string = '';          // 'awcms' | 'awcms-one'
  apiBaseUrl: string = '';       // https origin of the AWCMS backend
  storefrontOrigin: string = ''; // awcms-one only
  tenantId: string = '';         // awcms only, UUID
  locale: string = '';           // 'en' | 'id'
  appName: string = '';
  environment: string = '';      // 'development' | 'production'

  toGlobalProps(): Record<string, Object> {
    const props: Record<string, Object> = {};
    const put = (name: string, value: string): void => {
      const trimmed: string = value.trim();
      if (trimmed.length > 0) {
        props[name] = trimmed;
      }
    };
    put('backend', this.backend);
    put('apiBaseUrl', this.apiBaseUrl);
    put('storefrontOrigin', this.storefrontOrigin);
    put('tenantId', this.tenantId);
    put('locale', this.locale);
    put('appName', this.appName);
    put('environment', this.environment);
    return props;
  }
}

export class AwcmsLynxHost {
  /** The live LynxContext (set by AwcmsLynxView.onCreate) so the ability can forward deep links. */
  static current: LynxContext | undefined = undefined;
  private static pendingDeepLink: string | undefined = undefined;

  /**
   * Call from UIAbility.onCreate (sample EntryAbility). Devtool services are intentionally NOT
   * registered here so release builds carry no devtool code path; register them in a debug-only
   * block (hosts/harmony/README.md, "Devtool in debug builds").
   */
  static init(context: common.UIAbilityContext): void {
    LynxServiceCenter.registerService(LynxServiceType.Http, LynxHttpService.instance);
    LynxBaseServiceCenter.registerService(LynxBaseServiceType.Log, LynxLogService.instance);
    LLog.useSysLog(BuildProfile.DEBUG); // never mirror bundle console output into the system log in release
    LynxEnv.initialize(context);
    const options: Map<string, string> = new Map<string, string>();
    options.set('App', 'AwcmsLynx');
    options.set('AppVersion', '0.0.1'); // VERIFY: set from bundleManager versionName
    LynxEnv.setAppInfo(options);
    LynxEnv.enableDevtool(BuildProfile.DEBUG);
  }

  /** Call from UIAbility.onCreate and onNewWant. Only the app's own custom scheme is forwarded. */
  static handleWant(want: Want, scheme: string = 'awcmslynx'): void {
    const uri: string | undefined = want.uri;
    if (uri === undefined || uri.length > 2048 || !uri.toLowerCase().startsWith(scheme + ':')) {
      return;
    }
    if (AwcmsLynxHost.current !== undefined) {
      AwcmsLynxHost.current.sendGlobalEvent(DEEP_LINK_EVENT, [uri]); // lynx-context/send-global-event.mdx
    } else {
      AwcmsLynxHost.pendingDeepLink = uri; // cold start: delivered from onCreate below
    }
  }

  static onViewCreated(context: LynxContext): void {
    AwcmsLynxHost.current = context;
    if (AwcmsLynxHost.pendingDeepLink !== undefined) {
      context.sendGlobalEvent(DEEP_LINK_EVENT, [AwcmsLynxHost.pendingDeepLink]);
      AwcmsLynxHost.pendingDeepLink = undefined;
    }
  }

  static onViewDestroyed(): void {
    AwcmsLynxHost.current = undefined;
  }
}

/**
 * Bundle fetcher. Derived from ExampleTemplateResourceFetcher, plus name validation and a
 * runtime switch that refuses http(s) bundles outside debug builds.
 */
export class AwcmsTemplateResourceFetcher extends LynxTemplateResourceFetcher {
  private static readonly NAME: RegExp = new RegExp('^[A-Za-z0-9._/-]{1,128}$');
  private static readonly MAX_BYTES: number = 32 * 1024 * 1024;
  private allowRemote: boolean;
  private context: Context | undefined = undefined;

  constructor(allowRemote: boolean) {
    super();
    this.allowRemote = allowRemote;
  }

  /** The ability context is only known once the component appears (aboutToAppear). */
  attach(context: Context): void {
    this.context = context;
  }

  fetchTemplate(request: LynxResourceRequest, callback: AsyncCallback<TemplateProviderResult, void>): void {
    const url: string = request.url;
    if (url.startsWith('http://') || url.startsWith('https://')) {
      if (!this.allowRemote) {
        callback(AwcmsTemplateResourceFetcher.error('Remote bundles are disabled in this build'),
          { binary: new ArrayBuffer(0) });
        return;
      }
      const httpRequest: http.HttpRequest = http.createHttp();
      httpRequest.request(url, {
        expectDataType: http.HttpDataType.ARRAY_BUFFER,
        connectTimeout: 5000,
        readTimeout: 15000,
      }, (err: BusinessError, data: http.HttpResponse) => {
        const body: ArrayBuffer | undefined = data?.result as ArrayBuffer | undefined;
        if (!err && (body === undefined || body.byteLength > AwcmsTemplateResourceFetcher.MAX_BYTES)) {
          callback(AwcmsTemplateResourceFetcher.error('Dev server returned no usable bundle'),
            { binary: new ArrayBuffer(0) });
        } else {
          callback(err, { binary: body as ArrayBuffer });
        }
        httpRequest.destroy();
      });
      return;
    }
    if (!AwcmsTemplateResourceFetcher.NAME.test(url) || url.includes('..')) {
      callback(AwcmsTemplateResourceFetcher.error('Invalid bundle name'), { binary: new ArrayBuffer(0) });
      return;
    }
    if (this.context === undefined) {
      callback(AwcmsTemplateResourceFetcher.error('Fetcher is not attached to a context'), { binary: new ArrayBuffer(0) });
      return;
    }
    // Packaged bundle in resources/rawfile (sample ExampleTemplateResourceFetcher, "local file" branch).
    const resourceMgr: resourceManager.ResourceManager = this.context.resourceManager;
    resourceMgr.getRawFileContent(url, (err: BusinessError, data: Uint8Array) => {
      callback(err, { binary: data?.buffer as ArrayBuffer });
    });
  }

  /** SSR data is not used by this app; refuse instead of fetching arbitrary URLs. */
  fetchSSRData(request: LynxResourceRequest, callback: AsyncCallback<ArrayBuffer, void>): void {
    callback(AwcmsTemplateResourceFetcher.error('SSR data is not supported'), new ArrayBuffer(0));
  }

  private static error(message: string): BusinessError {
    // Same literal shape the sample's ExampleGenericResourceFetcher uses for its errors.
    const err: BusinessError = { code: LynxError.LYNX_ERROR_CODE_RESOURCE, message: message, name: 'Resource Error' };
    return err;
  }
}

/** Verbatim from the sample's ExampleMediaResourceFetcher. */
export class AwcmsMediaResourceFetcher extends LynxMediaResourceFetcher {
  shouldRedirectUrl(request: LynxResourceRequest): string {
    return request.url;
  }

  isLocalResource(url: string): LynxOptionalBool {
    return LynxOptionalBool.UNDEFINED;
  }
}

/**
 * Drop-in replacement for the sample's Index.ets body:
 *
 *   @Entry @Component struct Index {
 *     build() { AwcmsLynxView({ config: awcmsConfig() }) }
 *   }
 */
@Component
export struct AwcmsLynxView {
  config: AwcmsRuntimeConfig = new AwcmsRuntimeConfig();
  bundle: string = DEFAULT_BUNDLE;
  private templateResourceFetcher: AwcmsTemplateResourceFetcher = new AwcmsTemplateResourceFetcher(BuildProfile.DEBUG);
  private mediaResourceFetcher: LynxMediaResourceFetcher = new AwcmsMediaResourceFetcher();
  private genericResourceFetcher: LynxGenericResourceFetcher = new ExampleGenericResourceFetcher();
  private modules: Map<string, ModuleOptions> = new Map<string, ModuleOptions>();
  private metaData: MetaData = new MetaData(new TemplateData('{}'));

  aboutToAppear(): void {
    // VERIFY: getHostContext() (API 12+) returns the UIAbilityContext of the hosting ability.
    const abilityContext: common.UIAbilityContext = this.getUIContext().getHostContext() as common.UIAbilityContext;
    this.templateResourceFetcher.attach(abilityContext);
    // Registration shape from native-module-harmony.mdx: { moduleClass, param? }.
    this.modules.set(MODULE_NAME, { moduleClass: AwcmsHostBridgeModule, param: new AwcmsModuleParam(abilityContext) });
    // use-data-from-host-platform.mdx: MetaData(initialData, globalProps).
    this.metaData = new MetaData(new TemplateData('{}'), new TemplateData(this.config.toGlobalProps()));
  }

  aboutToDisappear(): void {
    AwcmsLynxHost.onViewDestroyed();
  }

  build() {
    Column() {
      LynxView({
        templateResourceFetcher: this.templateResourceFetcher,
        mediaResourceFetcher: this.mediaResourceFetcher,
        genericResourceFetcher: this.genericResourceFetcher,
        modules: this.modules,
        // VERIFY: the docs spell this prop `metadata` (use-data-from-host-platform.mdx, load-template.mdx)
        // in two places and `metaData` in integrate-lynx-devtool-advanced.mdx.
        metadata: this.metaData,
        url: this.bundle,
        onCreate: (context: LynxContext) => {
          AwcmsLynxHost.onViewCreated(context);
        },
      }).width('100%').height('100%');
    }
    .size({ width: '100%', height: '100%' })
  }
}
